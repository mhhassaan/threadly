# Local-only placeholders. Copy to .env; never commit actual secrets.
# Wrangler supplies the non-secret defaults below; these are server bindings.
BETTER_AUTH_URL=http://127.0.0.1:4173
BETTER_AUTH_SECRET=replace-with-a-random-local-secret-at-least-32-characters
EMAIL_TRANSPORT=capture
RESEND_FROM="Threadly <noreply@example.invalid>"
RESEND_API_KEY=
DEEPSEEK_API_KEY=
AI_ENABLED=false
AI_DAILY_SPEND_LIMIT_USD=0
